<%@ Page Title="" Language="C#" MasterPageFile="~/Home/Home.Master" AutoEventWireup="true" CodeBehind="about.aspx.cs" Inherits="MentorHub.Home.about" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
</asp:Content>
<asp:Content ID="Content3" ContentPlaceHolderID="ContentPlaceHolder2" runat="server">
        <section class="py-5">
      <div class="container">
        <div class="page-header">
          <span class="page-badge"><i class="bi bi-stars"></i>About MentorHub</span>
          <h1 class="display-6 fw-bold mt-3">Bridging ambition with experience.</h1>
          <p class="text-muted mt-2 mb-0">We empower students and professionals by connecting them with mentors who can guide their career, confidence, and capability growth.</p>
        </div>

        <div class="row g-4 align-items-center">
          <div class="col-lg-7">
            <div class="glass-card p-4 p-lg-5">
              <h3 class="fw-semibold mb-3">Our mission</h3>
              <p class="text-muted">MentorHub was built to make mentorship accessible, structured, and outcome-focused. Our platform helps young professionals discover experienced guides across software, product, design, business, and leadership domains.</p>
              <p class="text-muted">Whether a student needs interview preparation, a professional wants to transition industries, or a team wants to build a clearer learning path, MentorHub creates a trusted environment for meaningful guidance.</p>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="dashboard-card p-4">
              <h5 class="fw-semibold mb-3">Platform objectives</h5>
              <ul class="list-unstyled list-soft">
                <li><i class="bi bi-check2-circle text-success me-2"></i>Match mentees with mentors by skill and experience</li>
                <li><i class="bi bi-check2-circle text-success me-2"></i>Streamline career guidance and interview readiness</li>
                <li><i class="bi bi-check2-circle text-success me-2"></i>Support consistent learning through tracked sessions</li>
                <li><i class="bi bi-check2-circle text-success me-2"></i>Foster long-term professional relationships</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="row g-4 mt-2">
          <div class="col-md-4">
            <div class="dashboard-card p-4 h-100">
              <div class="feature-icon mb-3"><i class="bi bi-eye"></i></div>
              <h5>Vision</h5>
              <p class="text-muted mb-0">To become the most trusted mentoring ecosystem for career readiness and lifelong skill growth.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="dashboard-card p-4 h-100">
              <div class="feature-icon mb-3"><i class="bi bi-bullseye"></i></div>
              <h5>Focus</h5>
              <p class="text-muted mb-0">We focus on quality mentoring, measurable outcomes, and a premium user experience for all roles.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="dashboard-card p-4 h-100">
              <div class="feature-icon mb-3"><i class="bi bi-people"></i></div>
              <h5>Community</h5>
              <p class="text-muted mb-0">Mentorship becomes a growth community where students and professionals exchange insight regularly.</p>
            </div>
          </div>
        </div>

        <div class="row g-4 mt-2">
          <div class="col-lg-6">
            <div class="glass-card p-4 p-lg-5 h-100">
              <h4 class="fw-semibold mb-4">Our journey so far</h4>
              <div class="timeline-card">
                <h6 class="fw-semibold mb-1">2022 — The idea</h6>
                <p class="text-muted small mb-0">MentorHub started as a campus project to solve fragmented, informal mentorship.</p>
              </div>
              <div class="timeline-card">
                <h6 class="fw-semibold mb-1">2023 — First 500 mentors</h6>
                <p class="text-muted small mb-0">We onboarded mentors across software, design, and business functions.</p>
              </div>
              <div class="timeline-card">
                <h6 class="fw-semibold mb-1">2024 — Structured dashboards</h6>
                <p class="text-muted small mb-0">Introduced session tracking, ratings, and admin approval workflows.</p>
              </div>
              <div class="timeline-card mb-0">
                <h6 class="fw-semibold mb-1">Today — 2.4k+ active mentors</h6>
                <p class="text-muted small mb-0">A growing community with a 98% satisfaction rate among matched pairs.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="dashboard-card p-4 p-lg-5 h-100">
              <h4 class="fw-semibold mb-4">What we stand for</h4>
              <div class="d-flex gap-3 mb-4">
                <div class="feature-icon flex-shrink-0"><i class="bi bi-heart"></i></div>
                <div>
                  <h6 class="fw-semibold mb-1">Genuine guidance</h6>
                  <p class="text-muted small mb-0">Every match is built around real goals, not generic advice.</p>
                </div>
              </div>
              <div class="d-flex gap-3 mb-4">
                <div class="feature-icon flex-shrink-0"><i class="bi bi-graph-up"></i></div>
                <div>
                  <h6 class="fw-semibold mb-1">Measurable outcomes</h6>
                  <p class="text-muted small mb-0">Progress tracking keeps both sides accountable to real results.</p>
                </div>
              </div>
              <div class="d-flex gap-3">
                <div class="feature-icon flex-shrink-0"><i class="bi bi-shield-check"></i></div>
                <div>
                  <h6 class="fw-semibold mb-1">Trust &amp; safety</h6>
                  <p class="text-muted small mb-0">Admin approvals and reviews keep the community high-quality.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
</asp:Content>

