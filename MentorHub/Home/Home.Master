<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Home.master.cs" Inherits="MentorHub.Home.Home" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MentorHub | Mentor-Mentee Matching Platform</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/styles.css") %>" type="text/css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">
        <div>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">

                    <div class="container">

                        <!-- LOGO -->
                        <a class="navbar-brand" href="index.aspx">MentorHub
                </a>


                        <!-- MOBILE MENU BUTTON -->
                        <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar"
                            aria-expanded="false"
                            aria-label="Toggle navigation">

                            <span class="navbar-toggler-icon"></span>

                        </button>


                        <!-- NAVIGATION -->
                        <div class="collapse navbar-collapse"
                            id="mainNavbar">

                            <ul class="navbar-nav ms-auto align-items-lg-center">


                                <li class="nav-item">
                                    <a class="nav-link" href="about.aspx">About
                            </a>
                                </li>


                                <li class="nav-item">
                                    <a class="nav-link" href="how-it-works.aspx">How it Works
                            </a>
                                </li>


                                <li class="nav-item">
                                    <a class="nav-link" href="features.aspx">Features
                            </a>
                                </li>


                                <li class="nav-item">
                                    <a class="nav-link" href="mentors.aspx">Mentors
                            </a>
                                </li>


                                <li class="nav-item">
                                    <a class="nav-link" href="success-stories.aspx">Stories
                            </a>
                                </li>


                                <li class="nav-item">
                                    <a class="nav-link" href="faq.aspx">FAQ
                            </a>
                                </li>


                                <li class="nav-item">
                                    <a class="nav-link" href="contact.aspx">Contact
                            </a>
                                </li>


                                <li class="nav-item ms-lg-3">

                                    <a href="SignIn_up.aspx"
                                        class="btn gradient-btn">Sign In / Sign Up

                            </a>

                                </li>

                            </ul>

                        </div>

                    </div>

                </nav>

            </asp:ContentPlaceHolder>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                <section class="hero-section">
                    <div class="container">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-7 fade-in">
                                <h1 class="display-5 fw-bold mb-3">Find the right mentor and accelerate your growth.</h1>
                                <p class="lead text-muted mb-4">A modern mentor-mentee matching platform designed for students, professionals, and educators to connect, learn, and grow together.</p>
                                <div class="d-flex flex-wrap gap-3">
                                    <a href="SignIn_up.aspx" class="btn gradient-btn">Create Account</a>
                                    <a href="mentors.aspx" class="btn btn-outline-primary rounded-pill px-4">Explore Mentors</a>
                                </div>
                                <div class="row mt-4 g-3">
                                    <div class="col-md-4">
                                        <div class="glass-card p-3">
                                            <h4 class="fw-bold mb-0">2.4k+</h4>
                                            <small class="text-muted">Active Mentors</small>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="glass-card p-3">
                                            <h4 class="fw-bold mb-0">8.9k+</h4>
                                            <small class="text-muted">Successful Matches</small>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="glass-card p-3">
                                            <h4 class="fw-bold mb-0">98%</h4>
                                            <small class="text-muted">Satisfaction</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5 fade-in">
                                <div class="glass-card p-4">
                                    <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=900&q=80" class="rounded-4 shadow" alt="Mentorship" />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5">
                    <div class="container">
                        <div class="text-center mb-4 fade-in">
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Platform Highlights</span>
                            <h2 class="section-title mt-3">Built for better mentoring experiences</h2>
                            <p class="text-muted">Everything you need to match, communicate, and grow in one polished workspace.</p>
                        </div>
                        <div class="row g-4 mt-2">
                            <div class="col-md-4 fade-in">
                                <div class="dashboard-card p-4 h-100">
                                    <div class="feature-icon mb-3"><i class="bi bi-person-check"></i></div>
                                    <h5>Smart Matching</h5>
                                    <p class="text-muted">Discover mentors based on skills, domain, experience, and availability.</p>
                                </div>
                            </div>
                            <div class="col-md-4 fade-in">
                                <div class="dashboard-card p-4 h-100">
                                    <div class="feature-icon mb-3"><i class="bi bi-chat-dots"></i></div>
                                    <h5>Live Collaboration</h5>
                                    <p class="text-muted">Chat, schedule sessions, and meet in a modern, professional workspace.</p>
                                </div>
                            </div>
                            <div class="col-md-4 fade-in">
                                <div class="dashboard-card p-4 h-100">
                                    <div class="feature-icon mb-3"><i class="bi bi-graph-up-arrow"></i></div>
                                    <h5>Progress Tracking</h5>
                                    <p class="text-muted">Monitor growth, completion, and milestones with a clear learning dashboard.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5">
                    <div class="container">
                        <div class="text-center mb-4 fade-in">
                            <h2 class="section-title">Featured mentors</h2>
                            <p class="text-muted">Top mentors from technology, business, product, and design.</p>
                        </div>
                        <div class="row g-4">
                            <div class="col-lg-4 fade-in">
                                <div class="match-card dashboard-card">
                                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=900&q=80" alt="Mentor" />
                                    <div class="p-4">
                                        <h5 class="fw-semibold">Aisha Patel</h5>
                                        <p class="text-muted mb-2">Senior Product Designer</p>
                                        <div class="text-warning mb-3"><i class="bi bi-star-fill"></i>4.9</div>
                                        <a href="SignIn_up.aspx" class="btn gradient-btn w-100">View Profile</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4 fade-in">
                                <div class="match-card dashboard-card">
                                    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=900&q=80" alt="Mentor" />
                                    <div class="p-4">
                                        <h5 class="fw-semibold">Daniel Ross</h5>
                                        <p class="text-muted mb-2">Lead Software Engineer</p>
                                        <div class="text-warning mb-3"><i class="bi bi-star-fill"></i>4.8</div>
                                        <a href="SignIn_up.aspx" class="btn gradient-btn w-100">View Profile</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4 fade-in">
                                <div class="match-card dashboard-card">
                                    <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=900&q=80" alt="Mentor" />
                                    <div class="p-4">
                                        <h5 class="fw-semibold">Meera Singh</h5>
                                        <p class="text-muted mb-2">Business Consultant</p>
                                        <div class="text-warning mb-3"><i class="bi bi-star-fill"></i>5.0</div>
                                        <a href="SignIn_up.aspx" class="btn gradient-btn w-100">View Profile</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5">
                    <div class="container">
                        <div class="text-center mb-4 fade-in">
                            <h2 class="section-title">How MentorHub works</h2>
                            <p class="text-muted">Get matched and get moving in four simple steps.</p>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-6 col-lg-3 fade-in">
                                <div class="dashboard-card p-4 h-100 text-center">
                                    <span class="step-number mx-auto mb-3">1</span>
                                    <h6 class="fw-semibold">Create profile</h6>
                                    <p class="text-muted small mb-0">Share your goals, skills, and availability.</p>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 fade-in">
                                <div class="dashboard-card p-4 h-100 text-center">
                                    <span class="step-number mx-auto mb-3">2</span>
                                    <h6 class="fw-semibold">Get matched</h6>
                                    <p class="text-muted small mb-0">Discover mentors aligned to your path.</p>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 fade-in">
                                <div class="dashboard-card p-4 h-100 text-center">
                                    <span class="step-number mx-auto mb-3">3</span>
                                    <h6 class="fw-semibold">Book a session</h6>
                                    <p class="text-muted small mb-0">Schedule around real availability.</p>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 fade-in">
                                <div class="dashboard-card p-4 h-100 text-center">
                                    <span class="step-number mx-auto mb-3">4</span>
                                    <h6 class="fw-semibold">Track growth</h6>
                                    <p class="text-muted small mb-0">Watch milestones add up on your dashboard.</p>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-4 fade-in">
                            <a href="how-it-works.aspx" class="btn btn-outline-primary rounded-pill px-4">See the full journey</a>
                        </div>
                    </div>
                </section>

                <section class="py-5">
                    <div class="container">
                        <div class="text-center mb-4 fade-in">
                            <h2 class="section-title">What our community says</h2>
                            <p class="text-muted">Real feedback from mentees and mentors using MentorHub.</p>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4 fade-in">
                                <div class="glass-card testimonial-card p-4 h-100">
                                    <div class="text-warning mb-2"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></div>
                                    <p class="text-muted">"My mentor helped me restructure my portfolio and land interviews within weeks."</p>
                                    <h6 class="fw-semibold mb-0 mt-3">Riya Das</h6>
                                    <small class="text-muted">Mentee, BCA Graduate</small>
                                </div>
                            </div>
                            <div class="col-md-4 fade-in">
                                <div class="glass-card testimonial-card p-4 h-100">
                                    <div class="text-warning mb-2"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></div>
                                    <p class="text-muted">"Scheduling and progress tracking made it easy to stay consistent every week."</p>
                                    <h6 class="fw-semibold mb-0 mt-3">Karan Malhotra</h6>
                                    <small class="text-muted">Mentee, UX Designer</small>
                                </div>
                            </div>
                            <div class="col-md-4 fade-in">
                                <div class="glass-card testimonial-card p-4 h-100">
                                    <div class="text-warning mb-2"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></div>
                                    <p class="text-muted">"Mentoring on this platform is simple — I manage requests and sessions in one place."</p>
                                    <h6 class="fw-semibold mb-0 mt-3">Aisha Patel</h6>
                                    <small class="text-muted">Mentor, Senior Product Designer</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5">
                    <div class="container">
                        <div class="row g-4 align-items-center">
                            <div class="col-lg-6 fade-in">
                                <h2 class="section-title">Made for students, professionals, and institutions</h2>
                                <p class="text-muted">The project is polished, responsive, and suitable for a Final Year BCA project presentation with a professional UI experience.</p>
                                <ul class="list-unstyled">
                                    <li><i class="bi bi-check-circle-fill text-success me-2"></i>Responsive for desktop, tablet, and mobile</li>
                                    <li><i class="bi bi-check-circle-fill text-success me-2"></i>Clean admin, mentor, and mentee dashboards</li>
                                    <li><i class="bi bi-check-circle-fill text-success me-2"></i>Modern cards, charts, profile pages, and chat UI</li>
                                </ul>
                            </div>
                            <div class="col-lg-6 fade-in">
                                <div class="glass-card p-4">
                                    <img src="https://images.unsplash.com/photo-1516321497487-e288fb19713f?auto=format&fit=crop&w=900&q=80" class="rounded-4" alt="Dashboard" />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5">
                    <div class="container">
                        <div class="dashboard-card p-5 text-center fade-in">
                            <span class="page-badge mb-3"><i class="bi bi-rocket-takeoff"></i>Join today</span>
                            <h3 class="fw-bold mt-3 mb-2">Your next mentor is one click away.</h3>
                            <p class="text-muted mb-4">It's free to create an account and explore mentors across every domain.</p>
                            <div class="d-flex justify-content-center gap-3 flex-wrap">
                                <a href="SignIn_up.aspx" class="btn gradient-btn">Get Started Free</a>
                                <a href="how-it-works.aspx" class="btn btn-outline-primary rounded-pill px-4">How it Works</a>
                            </div>
                        </div>
                    </div>
                </section>
            </asp:ContentPlaceHolder>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
                <footer class="footer mt-5">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-lg-4">
                                <h5 class="text-white">MentorHub</h5>
                                <p class="small mb-3">Mentoring that moves careers forward with structured guidance, smart matching, and real growth.</p>
                                <div class="d-flex gap-3">
                                    <a href="https://www.linkedin.com" class="text-light" target="_blank" rel="noreferrer"><i class="bi bi-linkedin"></i></a>
                                    <a href="https://www.instagram.com" class="text-light" target="_blank" rel="noreferrer"><i class="bi bi-instagram"></i></a>
                                    <a href="https://www.twitter.com" class="text-light" target="_blank" rel="noreferrer"><i class="bi bi-twitter"></i></a>
                                </div>
                                <div class="mt-3 p-3 rounded-3 bg-white bg-opacity-10 border border-light border-opacity-10">
                                    <p class="small mb-0 text-light">
                                        <i class="bi bi-shield-check me-2"></i>Trusted by students, mentors, and growing communities.
                   
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <h6 class="text-white mb-3">Explore</h6>
                                <ul class="list-unstyled small">
                                    <li class="mb-2"><a href="about.aspx" class="text-light">About</a></li>
                                    <li class="mb-2"><a href="features.aspx" class="text-light">Features</a></li>
                                    <li class="mb-2"><a href="mentors.aspx" class="text-light">Mentors</a></li>
                                    <li><a href="success-stories.aspx" class="text-light">Stories</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-3 col-md-4">
                                <h6 class="text-white mb-3">Support</h6>
                                <ul class="list-unstyled small">
                                    <li class="mb-2"><a href="faq.aspx" class="text-light">FAQ</a></li>
                                    <li class="mb-2"><a href="contact.aspx" class="text-light">Contact</a></li>
                                    <li class="mb-2"><a href="forgot-password.aspx" class="text-light">Forgot Password</a></li>
                                    <li><a href="SignIn_up.aspx" class="text-light">Sign In</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-3 col-md-4">
                                <h6 class="text-white mb-3">Get Started</h6>
                                <ul class="list-unstyled small">
                                    <li class="mb-2"><a href="SignIn_up.aspx" class="text-light">Sign Up</a></li>
                                    <li class="mb-2"><a href="how-it-works.aspx" class="text-light">How it Works</a></li>
                                    <li><a href="contact.aspx" class="text-light">Book a Demo</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="border-top border-secondary mt-4 pt-3 text-center small">© <span id="year"></span>MentorHub. All rights reserved.</div>
                    </div>
                </footer>
            </asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
    <script src="<%= ResolveUrl("~/assets/js/main.js") %>">
    </script>
</body>
</html>
