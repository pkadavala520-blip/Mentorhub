<body class="mentor-shell" data-page="settings"><div class="d-flex mentor-layout"><aside class="sidebar mp-sidebar"><div class="mp-brand"><div class="mp-brand-mark"><i class="bi bi-mortarboard-fill"></i></div><div class="mp-brand-text"><h4>MentorHub</h4><span>Mentor Panel</span></div></div><nav class="mp-nav nav flex-column"><div class="mp-nav-section-label">Overview</div><a class="nav-link" href="index.aspx"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a><a class="nav-link" href="profile.aspx"><i class="bi bi-person"></i><span>My Profile</span></a><a class="nav-link" href="my-skills.aspx"><i class="bi bi-lightbulb"></i><span>My Skills</span></a><div class="mp-nav-section-label">Mentoring</div><a class="nav-link" href="availability.aspx"><i class="bi bi-calendar2-week"></i><span>Availability</span></a><a class="nav-link" href="requests.aspx"><i class="bi bi-ui-checks"></i><span>Matching Requests</span><span class="mp-nav-badge" data-badge="requests">0</span></a><a class="nav-link" href="mentees.aspx"><i class="bi bi-people"></i><span>My Mentees</span></a><a class="nav-link" href="messages.aspx"><i class="bi bi-chat-dots"></i><span>Messages</span><span class="mp-nav-badge" data-badge="messages">0</span></a><a class="nav-link" href="schedule.aspx"><i class="bi bi-calendar2-event"></i><span>Schedule</span></a><div class="mp-nav-section-label">Insights</div><a class="nav-link" href="feedback.aspx"><i class="bi bi-star"></i><span>Feedback</span></a><a class="nav-link" href="notifications.aspx"><i class="bi bi-bell"></i><span>Notifications</span></a><a class="nav-link active" href="settings.aspx"><i class="bi bi-gear"></i><span>Settings</span></a></nav><div class="mp-sidebar-footer"><div class="mp-mini-profile mb-2"><span class="mp-avatar sm" data-mini-avatar>DR</span><div class="mp-mini-profile-text"><strong data-mini-name>Daniel Ross</strong><span><span class="mp-status-dot d-inline-block me-1"></span>Active now</span></div></div><a class="nav-link mp-danger" href="../Home/SignIn_up.aspx"><i class="bi bi-box-arrow-right"></i><span>Logout</span></a></div></aside>
<main class="flex-grow-1 content-area p-4"><div class="mp-topbar mb-4"><div class="d-flex align-items-center gap-3 flex-grow-1"><button class="mp-mobile-toggle" data-sidebar-toggle><i class="bi bi-list"></i></button><div class="mp-search d-none d-md-block"><i class="bi bi-search"></i><input placeholder="Search mentees, requests, sessions…"/></div></div><div class="d-flex align-items-center gap-2"><button class="mp-icon-btn" data-dark-toggle title="Toggle dark mode"><i class="bi bi-moon-stars"></i></button><div class="dropdown"><button class="mp-icon-btn" data-bs-toggle="dropdown"><i class="bi bi-bell"></i><span class="mp-dot" data-notif-dot></span></button><div class="dropdown-menu dropdown-menu-end mp-dropdown-menu"><div class="d-flex justify-content-between px-2 pb-2"><strong>Notifications</strong><a href="notifications.aspx" class="small">View all</a></div><div data-notif-list></div></div></div><div class="dropdown"><button class="btn p-0 border-0" data-bs-toggle="dropdown"><span class="mp-avatar sm" data-mini-avatar>DR</span></button><div class="dropdown-menu dropdown-menu-end mp-dropdown-menu"><a class="dropdown-item" href="profile.aspx"><i class="bi bi-person me-2"></i>My Profile</a><a class="dropdown-item" href="settings.aspx"><i class="bi bi-gear me-2"></i>Settings</a><hr/><a class="dropdown-item text-danger" href="../Home/SignIn_up.aspx"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></div></div></div></div>
<div class="mp-page-head fade-in"><div><span class="mp-page-eyebrow"><i class="bi bi-gear"></i>Settings</span><h2>Account settings</h2><p>Manage your profile, notifications, appearance, and security.</p></div></div>
<div class="row g-4"><div class="col-xl-3 fade-in"><div class="mp-card p-3 mp-settings-sidebar"><div class="mp-settings-photo"><div class="mp-settings-avatar"><img data-settings-photo src="" alt="Profile photo"/><span data-settings-photo-fallback>DR</span></div><button type="button" class="mp-btn mp-btn-outline btn-sm" data-settings-photo-btn><i class="bi bi-camera"></i>Change Photo</button><input type="file" accept="image/*" data-settings-photo-input hidden/></div><nav class="nav flex-column mp-settings-nav"><a class="nav-link active" data-bs-toggle="tab" href="#mpTabAccount"><i class="bi bi-person"></i>Account</a><a class="nav-link" data-bs-toggle="tab" href="#mpTabNotif"><i class="bi bi-bell"></i>Notifications</a><a class="nav-link" data-bs-toggle="tab" href="#mpTabAvailability"><i class="bi bi-calendar2-week"></i>Availability</a><a class="nav-link" data-bs-toggle="tab" href="#mpTabAppearance"><i class="bi bi-palette"></i>Appearance</a><a class="nav-link" data-bs-toggle="tab" href="#mpTabSecurity"><i class="bi bi-shield-lock"></i>Security</a></nav></div></div>
<div class="col-xl-9 fade-in"><div class="tab-content"><div class="tab-pane fade show active" id="mpTabAccount"><div class="mp-card p-4"><div class="d-flex justify-content-between align-items-center mb-3"><h5>Profile preferences</h5><span class="mp-mini-label">Saved locally</span></div><form class="row g-3" data-settings-form><div class="col-md-6"><label class="form-label">Display Name</label><input class="form-control" name="displayName" required/></div><div class="col-md-6"><label class="form-label">Notification Email</label><input type="email" class="form-control" name="email" required/></div><div class="col-md-6"><label class="form-label">Phone Number</label><input class="form-control" name="phone" placeholder="+91 98765 43210"/></div><div class="col-12"><button type="submit" class="mp-btn mp-btn-primary"><i class="bi bi-check2-circle"></i>Save Preferences</button></div></form></div></div>
<div class="tab-pane fade" id="mpTabNotif"><div class="mp-card p-4"><h5>Notification preferences</h5><p class="text-muted small">Choose how MentorHub keeps you updated.</p><div class="mp-setting-row"><div><strong>Email notifications</strong><div class="text-muted small">New requests, messages, and important updates.</div></div><label class="mp-switch"><input type="checkbox" data-email-toggle/><span class="mp-slider"></span></label></div><div class="mp-setting-row"><div><strong>SMS notifications</strong><div class="text-muted small">A reminder before upcoming mentoring sessions.</div></div><label class="mp-switch"><input type="checkbox" data-sms-toggle/><span class="mp-slider"></span></label></div></div></div>
<div class="tab-pane fade" id="mpTabAvailability"><div class="mp-card p-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h5>Availability</h5><p class="text-muted small mb-0">Manage the times mentees can request you.</p></div><a class="mp-btn mp-btn-primary btn-sm" href="availability.aspx"><i class="bi bi-pencil"></i>Edit schedule</a></div><div class="mp-availability-summary"><span><i class="bi bi-calendar2-check"></i>Mon, Wed, Fri, Sat</span><span><i class="bi bi-clock"></i>6:30 PM – 10:00 PM</span></div></div></div>
<div class="tab-pane fade" id="mpTabAppearance"><div class="mp-card p-4"><h5>Appearance</h5><div class="mp-setting-row"><div><strong>Dark mode</strong><div class="text-muted small">Switch to a low-light theme and remember your choice.</div></div><label class="mp-switch"><input type="checkbox" data-dark-toggle/><span class="mp-slider"></span></label></div></div></div>
<div class="tab-pane fade" id="mpTabSecurity"><div class="mp-card p-4"><h5>Security</h5><p class="text-muted small">Update your demo password locally.</p><form class="row g-3" data-security-form><div class="col-md-6"><label class="form-label">Current Password</label><input type="password" class="form-control" name="currentPassword" required/></div><div class="col-md-6"><label class="form-label">New Password</label><input type="password" class="form-control" name="newPassword" minlength="6" required/></div><div class="col-12"><button class="mp-btn mp-btn-primary"><i class="bi bi-shield-check"></i>Update Password</button></div></form><button type="button" class="mp-btn mp-btn-danger-soft mt-3" data-reset-demo><i class="bi bi-arrow-counterclockwise"></i>Reset demo data</button></div></div></div></div></div></div></main></div>
<script src="../assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script><script src="../assets/js/mentor-app.js?v=7"></script></body></html>
