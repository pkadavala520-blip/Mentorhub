<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="MentorHub.Admin.Admin" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | MentorHub</title>
    <link href="../assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="../assets/vendor/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="../assets/css/styles.css?v=6" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                <div class="d-flex">
                    <aside class="sidebar p-3">
                        <h4 class="fw-bold mb-4"><i class="bi bi-shield-lock me-2"></i>Admin Panel</h4>
                        <nav class="nav flex-column">
                            <a class="nav-link active" href="index.aspx"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                            <a class="nav-link" href="manage-mentors.aspx"><i class="bi bi-people me-2"></i>Manage Mentors</a>
                            <a class="nav-link" href="manage-mentees.aspx"><i class="bi bi-person-workspace me-2"></i>Manage Mentees</a>
                            <a class="nav-link" href="matching-requests.aspx"><i class="bi bi-ui-checks me-2"></i>Matching Requests</a>
                            <a class="nav-link" href="sessions.aspx"><i class="bi bi-calendar2-week me-2"></i>Sessions</a>
                            <a class="nav-link" href="reports.aspx"><i class="bi bi-bar-chart me-2"></i>Reports</a>
                            <a class="nav-link" href="feedback.aspx"><i class="bi bi-chat-left-text me-2"></i>Feedback</a>
                            <a class="nav-link" href="categories.aspx"><i class="bi bi-tags me-2"></i>Categories</a>
                            <a class="nav-link" href="skills.aspx"><i class="bi bi-lightbulb me-2"></i>Skills</a>
                            <a class="nav-link" href="announcements.aspx"><i class="bi bi-megaphone me-2"></i>Announcements</a>
                            <a class="nav-link" href="settings.aspx"><i class="bi bi-gear me-2"></i>Settings</a>
                            <a class="nav-link" href="profile.aspx"><i class="bi bi-person me-2"></i>Profile</a>
                            <a class="nav-link" href="../Home/SignIn_up.aspx"><i class="bi bi-box-arrow-right me-2"></i>Logout</a>
                        </nav>
                    </aside>
            </asp:ContentPlaceHolder>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                <main class="flex-grow-1 content-area p-4">
                    <div class="topbar rounded-4 p-3 mb-4 d-flex justify-content-between align-items-center">
                        <div>
                            <button class="btn btn-outline-secondary me-3 sidebar-toggle-btn" data-sidebar-toggle aria-label="Toggle navigation menu" aria-expanded="false"><i class="bi bi-list"></i></button>
                            <span class="fw-semibold">Welcome back, Admin</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-bell fs-5"></i>
                            <img src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'><rect width='200' height='200' fill='%23eef0f3'/><circle cx='100' cy='78' r='38' fill='%23a9b4c2'/><path d='M28 192 C28 128 172 128 172 192 Z' fill='%23a9b4c2'/></svg>" class="profile-avatar profile-photo profile-photo-empty" data-photo-key="adminProfilePhoto" alt="Profile" />
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-lg-4 col-md-6">
                            <div class="dashboard-card p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1">Total Mentors</p>
                                        <h3 class="fw-bold mb-0">248</h3>
                                    </div>
                                    <div class="icon-badge"><i class="bi bi-person-workspace"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="dashboard-card p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1">Total Mentees</p>
                                        <h3 class="fw-bold mb-0">1,284</h3>
                                    </div>
                                    <div class="icon-badge"><i class="bi bi-people"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="dashboard-card p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1">Total Matches</p>
                                        <h3 class="fw-bold mb-0">642</h3>
                                    </div>
                                    <div class="icon-badge"><i class="bi bi-person-check"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="dashboard-card p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1">Pending Requests</p>
                                        <h3 class="fw-bold mb-0">43</h3>
                                    </div>
                                    <div class="icon-badge"><i class="bi bi-hourglass-split"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="dashboard-card p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1">Completed Sessions</p>
                                        <h3 class="fw-bold mb-0">318</h3>
                                    </div>
                                    <div class="icon-badge"><i class="bi bi-calendar2-check"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="dashboard-card p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1">Reports</p>
                                        <h3 class="fw-bold mb-0">12</h3>
                                    </div>
                                    <div class="icon-badge"><i class="bi bi-file-earmark-bar-graph"></i></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-lg-7">
                            <div class="dashboard-card p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-semibold mb-0">Platform Analytics</h5>
                                    <span class="badge bg-primary-subtle text-primary">Monthly</span>
                                </div>
                                <canvas id="analyticsChart" height="180"></canvas>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="dashboard-card p-4">
                                <h5 class="fw-semibold mb-3">Category Breakdown</h5>
                                <canvas id="categoryChart" height="180"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="dashboard-card p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-semibold mb-0">Recent Matching Requests</h5>
                            <a href="matching-requests.aspx" class="btn btn-sm gradient-btn">View All</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Request ID</th>
                                        <th>Mentee</th>
                                        <th>Mentor</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>#M102</td>
                                        <td>Naina Shah</td>
                                        <td>Daniel Ross</td>
                                        <td><span class="badge bg-warning text-dark">Pending</span></td>
                                        <td>22 Jul 2026</td>
                                    </tr>
                                    <tr>
                                        <td>#M103</td>
                                        <td>Rohan Verma</td>
                                        <td>Meera Singh</td>
                                        <td><span class="badge bg-success">Approved</span></td>
                                        <td>21 Jul 2026</td>
                                    </tr>
                                    <tr>
                                        <td>#M104</td>
                                        <td>Jiya Rao</td>
                                        <td>Aisha Patel</td>
                                        <td><span class="badge bg-info text-dark">In Review</span></td>
                                        <td>20 Jul 2026</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </main>
        </div>
        </asp:ContentPlaceHolder>
        </div>
    </form>
    <script src="../assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/vendor/chartjs/chart.umd.js"></script>
    <script src="../assets/js/main.js?v=6"></script>
    <script>
        const analytics = document.getElementById('analyticsChart');
        if (analytics) {
            new Chart(analytics, {
                type: 'bar',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [{
                        label: 'Matches',
                        data: [120, 130, 145, 160, 180, 210],
                        backgroundColor: ['#4f46e5', '#7c3aed', '#4f46e5', '#7c3aed', '#4f46e5', '#7c3aed']
                    }]
                },
                options: { responsive: true, plugins: { legend: { display: false } } }
            });
        }
        const category = document.getElementById('categoryChart');
        if (category) {
            new Chart(category, {
                type: 'doughnut',
                data: {
                    labels: ['Tech', 'Business', 'Design', 'Education'],
                    datasets: [{
                        data: [35, 25, 20, 20],
                        backgroundColor: ['#4f46e5', '#7c3aed', '#22c55e', '#f59e0b']
                    }]
                },
                options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
            });
        }
    </script>

</body>
</html>
